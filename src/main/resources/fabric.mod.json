{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author1}",
    "${mod_author2}",
    "${mod_author3}"
  ],
  "contact": {
    "homepage": "${homepage}"
  },
  "license": "${license}",
  "icon": "pack.png",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord}"
      }
    }
  },
  "environment": "*",
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "cristellib": ">=${cristellib_version}"
  }
}
